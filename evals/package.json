{
  "name": "cerbos-skills-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Nightly promptfoo evals for the Cerbos agent skills",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "calibrate": "promptfoo eval -c promptfoo.calibration.yaml",
    "eval:policy": "promptfoo eval -c promptfoo.policy.yaml",
    "eval:synapse": "promptfoo eval -c promptfoo.synapse.yaml",
    "eval": "npm run calibrate && npm run eval:policy && npm run eval:synapse",
    "target": "bash scripts/eval.sh",
    "view": "promptfoo view"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "js-yaml": "^5.2.1",
    "promptfoo": "^0.121.0"
  }
}
