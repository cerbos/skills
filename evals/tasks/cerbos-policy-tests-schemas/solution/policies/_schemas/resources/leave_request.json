{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "owner": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "finance",
        "hr",
        "sales"
      ]
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  },
  "required": [
    "owner",
    "department",
    "days"
  ],
  "additionalProperties": false
}
